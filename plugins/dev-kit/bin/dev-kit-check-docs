#!/usr/bin/env python
"""Run scripts/check_docs.py of this plugin; the plugin bin folder is on the Bash tool PATH."""
import os
import runpy

script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts", "check_docs.py")
runpy.run_path(os.path.normpath(script), run_name="__main__")
