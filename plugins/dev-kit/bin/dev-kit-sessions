#!/bin/sh
# Run scripts/sessions.py of this plugin; the plugin bin folder is on the Bash tool PATH.
# cygpath hands Windows python a path it can open even when Git Bash path conversion is off
# (as seen in background sessions).
here=$(dirname "$0")
command -v cygpath >/dev/null 2>&1 && here=$(cygpath -m "$here")
exec python "$here/../scripts/sessions.py" "$@"
