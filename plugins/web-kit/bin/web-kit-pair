#!/bin/sh
# Run scripts/pair.mjs of this plugin; the plugin bin folder is on the Bash tool PATH.
# cygpath hands Windows node a path it can open even when Git Bash path conversion is off
# (plugins/dev-kit/claude-facts.md, "Git Bash may run with path conversion off in background sessions").
here=$(dirname "$0")
command -v cygpath >/dev/null 2>&1 && here=$(cygpath -m "$here")
exec node "$here/../scripts/pair.mjs" "$@"
